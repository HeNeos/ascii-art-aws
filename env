AWS_ACCOUNT_ID = ${AWS_ACCOUNT_ID}
AWS_BUCKET_NAME = "oidc-github-${AWS_ACCOUNT_ID}"
AWS_ROLE = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/oidc-github-role"

{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::oidc-github-${AWS_ACCOUNT_ID}/*",
                "arn:aws:s3:::oidc-github-${AWS_ACCOUNT_ID}"
            ]
        }
    ]
}


